# Dependency lifecycle scripts are the delivery mechanism for the current
# generation of npm worms: a compromised release adds a `preinstall` hook that
# runs before any of your code does, harvests npm/GitHub/cloud credentials, and
# republishes itself through the tokens it finds.
#
# Nothing in this dependency tree needs an install script. The only package that
# declares one is fsevents, an optional macOS file-watcher used by vitest's watch
# mode, which is not required for `vitest run`.
#
# The publish path is unaffected: CI runs lint and build as explicit steps before
# the release, so the prepublish hooks this also suppresses were redundant.
ignore-scripts=true
